name: CWA Weather Auto-Deploy & Pipeline CI/CD

on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]
  schedule:
    # 每天每 6 小時自動執行 CWA 爬蟲與更新
    - cron: '0 */6 * * *'
  workflow_dispatch:

permissions:
  contents: write
  pages: write
  id-token: write

concurrency:
  group: "pages"
  cancel-in-progress: false

jobs:
  build-and-crawl:
    runs-on: ubuntu-latest
    steps:
      - name: 檢出專案代碼 (Checkout Repository)
        uses: actions/checkout@v4

      - name: 設定 Python 環境 (Setup Python)
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: 安裝相依套件 (Install Dependencies)
        run: |
          python -m pip install --upgrade pip
          pip install requests pandas

      - name: 執行中央氣象署爬蟲並更新資料庫 (Run Crawler & DB Sync)
        run: |
          python crawl_and_save.py

      - name: 上傳 GitHub Pages 建置產物 (Upload Pages Artifact)
        uses: actions/upload-pages-artifact@v3
        with:
          path: '.'

  deploy-github-pages:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    needs: build-and-crawl
    if: github.ref == 'refs/heads/main'
    steps:
      - name: 自動部署至 GitHub Pages (Deploy to GitHub Pages)
        id: deployment
        uses: actions/deploy-pages@v4
